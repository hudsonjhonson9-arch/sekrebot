      {
        "parameters": {
          "jsCode": "const b = $input.item.json.body || $input.item.json;\nconst q = $input.item.json.query || {};\nif (!b.nama) throw new Error('Nama barang wajib diisi');\nconst jenis = b.jenisbarang || 'Aset Tetap';\nconst jenisPrefix = jenis === 'Aset Tetap' ? 'AT' : 'HP';\nconst katPrefix = (b.kategoriid || 'KTG').toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0,5);\nif (!b.kodebarang) {\n  const rand = String(Date.now()).slice(-4);\n  b.kodebarang = jenisPrefix + '-' + katPrefix + '-' + rand;\n}\nreturn [{ json: {\n  id: b.id || null,\n  nama: b.nama,\n  kodebarang: b.kodebarang,\n  jenisbarang: jenis,\n  satuan: b.satuan || 'Unit',\n  spesifikasi: b.spesifikasi || '',\n  foto: b.foto || '',\n  stok_saat_ini: parseInt(b.stok_saat_ini) || 0,\n  hargasatuan: parseFloat(b.hargasatuan) || 0,\n  kategoriid: b.kategoriid || null,\n  minimumstok: parseInt(b.minimumstok) || 0,\n  instansi_id: b.instansi_id || q.instansi_id || 'bapperida'\n} }];"
        },
