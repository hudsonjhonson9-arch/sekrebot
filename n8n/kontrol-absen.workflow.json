    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input.body || {};\nconst hdrs = input.headers || {};\nconst instId = String(body.instansi_id || 'bapperida').replace(/'/g, \"''\");\n\nconst times = Array.isArray(body.times) ? body.times.map(t => ({\n  jam: String(t.jam || '').slice(0, 5),\n  aktif: t.aktif !== false\n})) : [];\nconst value = JSON.stringify({\n  enabled: !!body.enabled,\n  toleransi: parseInt(body.toleransi, 10) || 30,\n  times\n});\n\nconst auth = String(hdrs.authorization || hdrs.Authorization || '').replace(/^Bearer\\s+/i, '').trim();\nconst parts = auth.split('_');\nconst userId = parseInt(parts[1]) || 0;\n\nconst sql = `SELECT COALESCE((SELECT is_admin FROM user_list WHERE id = ${userId}), false) AS is_admin, '${value.replace(/'/g, \"''\")}' AS value, '${instId}' AS inst_id`;\nreturn [{ json: { sql } }];"
      },
