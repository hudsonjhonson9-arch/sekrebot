  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "simapo-opname-save",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "10946bfc-542f-4808-bb3d-f27eb86a90bb",
      "name": "WH Simpan Opname",
      "webhookId": "simapo-opname-save"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO \"SIMAPO\".stock_opname (id, nomoropname, tanggal, status, createdat, updatedat, instansi_id, createdbyid) VALUES (gen_random_uuid(), 'OPN-' + TO_CHAR(NOW(), 'YYYYMMDDHH24MISS'), NOW(), 'SELESAI', NOW(), NOW(), '{{ ($json.body.instansi_id || $json.query.instansi_id || \"bapperida\").toString().replace(/'/g, \"''\") }}', '{{ ($json.headers[\"x-nip\"] || $json.body.nip || \"ADMIN\").toString().replace(/'/g, \"''\") }}') RETURNING id;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        0
      ],
      "id": "940017f7-be4c-4f12-a1bf-27cbeff1e073",
      "name": "Insert Opname Head",
      "credentials": {
        "postgres": {
          "id": "vYOiyrTftLtD3zzd",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const b = $node[\"WH Simpan Opname\"].json.body || $node[\"WH Simpan Opname\"].json;\nconst items = b.items || [];\nconst opnameid = $input.item.json.id;\nreturn items.map(i => ({ json: { \n  opnameid,\n  instansi_id: b.instansi_id || $input.item.json.query?.instansi_id || 'bapperida',\n  barangid: i.id, \n  stokfisik: parseInt(i.stok_fisik) || 0, \n  stoksistem: parseInt(i.stok_sistem) || 0,\n  selisih: (parseInt(i.stok_fisik) || 0) - (parseInt(i.stok_sistem) || 0)\n} }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "id": "2d3b4f71-544a-43f4-85b4-1ccccff9ca3b",
      "name": "Prepare Details"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO \"SIMAPO\".detail_opname (id, opnameid, barangid, stoksistem, stokfisik, selisih, instansi_id) VALUES (gen_random_uuid(), '{{ ($json.opnameid).toString().replace(/'/g, \"''\") }}', '{{ ($json.barangid).toString().replace(/'/g, \"''\") }}', {{ ($json.stoksistem).toString().replace(/'/g, \"''\") }}, {{ ($json.stokfisik).toString().replace(/'/g, \"''\") }}, {{ ($json.selisih).toString().replace(/'/g, \"''\") }}, '{{ ($json.instansi_id || \"bapperida\").toString().replace(/'/g, \"''\") }}'); UPDATE \"SIMAPO\".barang SET stok_saat_ini = {{ ($json.stokfisik).toString().replace(/'/g, \"''\") }}, updatedat = NOW() WHERE id = '{{ ($json.barangid).toString().replace(/'/g, \"''\") }}';",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        720,
        0
      ],
      "id": "9e56ccb1-4c84-47dc-aad2-cd120a5401d7",
      "name": "PG Insert Detail & Update",
      "credentials": {
        "postgres": {
          "id": "vYOiyrTftLtD3zzd",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { success: true, message: 'Stok opname berhasil disimpan' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "id": "f3ef8195-5691-40a7-83a8-d9a11cb72d4f",
      "name": "Response"
    },
