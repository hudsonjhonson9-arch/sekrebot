      ],
      "id": "bd82a992-6bc3-4872-962b-ca7e940af871",
      "name": "Get Dokumen by user_id",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "vYOiyrTftLtD3zzd",
          "name": "Postgres account"
        }
      }
