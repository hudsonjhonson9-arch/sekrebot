    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT nip, nama_dokumen, jenis, tanggal, instansi_id, link, tambah_oleh FROM \"dokumen_pegawai\" WHERE nip = '{{ ($json.NIP).toString().replace(/'/g, \"''\") }}'",
