        "additionalFields": {
          "caption": "=📊 *REKAP ABSENSI — {{ ($node[\"CORS Kirim\"].json.body.instansi_name || $node[\"CORS Kirim\"].json.body.instansi_id || 'BAPPERIDA').toUpperCase() }}*\n📅 {{ $node[\"CORS Kirim\"].json.body.tanggal_label }}\n────────────────\n_File PDF Terlampir_",
