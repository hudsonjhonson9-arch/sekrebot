      "parameters": {
        "jsCode": "const method = $input.first().json.headers?.['x-forwarded-method'] || $input.first().json.method || '';\n\nif (method === 'OPTIONS') {\n  $execution.respond({\n    statusCode: 200,\n    headers: {\n      'Access-Control-Allow-Origin': '*',\n      'Access-Control-Allow-Methods': 'POST,GET,OPTIONS',\n      'Access-Control-Allow-Headers': 'Content-Type,ngrok-skip-browser-warning,Accept,Authorization'\n    },\n    body: ''\n  });\n  return [];\n}\n\nreturn $input.all();"
      },
