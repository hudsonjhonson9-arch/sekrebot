        "jsCode": "const q = $input.first().json.query || {};\nconst instId = String(q.instansi_id || q.instansi || 'bapperida').replace(/'/g, \"''\");\n\nreturn [{ json: { sql: `SELECT key, value FROM pengaturan WHERE key = 'kontrol_absen' AND instansi_id = '${instId}'` } }];"
      },
