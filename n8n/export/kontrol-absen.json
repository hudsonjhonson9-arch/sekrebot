      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, config: $json.config }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "e9a6be89-8788-4f3b-8d29-8cb09e6469f4",
