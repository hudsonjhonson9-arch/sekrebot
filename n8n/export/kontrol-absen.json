    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst DEFAULT = { enabled: false, toleransi: 30, times: [{ jam: '10:00', aktif: true }] };\nlet config = DEFAULT;\nif (items.length && items[0].json && typeof items[0].json.value === 'string') {\n  try { config = { ...DEFAULT, ...JSON.parse(items[0].json.value) }; } catch (_) {}\n  if (!Array.isArray(config.times)) config.times = [];\n}\n\nreturn [{ json: { ok: true, config } }];"
      },
      "id": "f3eb9517-b0c6-4821-bcc9-80456f86a182",
      "name": "Format Config",
