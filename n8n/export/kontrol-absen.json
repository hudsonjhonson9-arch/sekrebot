    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst instId = String(j.inst_id || 'bapperida').replace(/'/g, \"''\");\nconst value = String(j.value || '').replace(/'/g, \"''\");\n\nconst sql = `INSERT INTO pengaturan (key, value, instansi_id) VALUES ('kontrol_absen', '${value}', '${instId}') ON CONFLICT (key, instansi_id) DO UPDATE SET value = EXCLUDED.value RETURNING key`;\nreturn [{ json: { sql } }];"
