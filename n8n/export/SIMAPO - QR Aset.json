    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(json_agg(t.*), '[]'::json) as items FROM (\n  SELECT ua.id, b.nama AS nama_barang, b.kodebarang, ua.nomorinventaris, ua.kondisi, ua.statuspinjam, b.foto AS foto_barang,\n    (\n      SELECT json_build_object(\n        'id', p.id,\n        'nama', COALESCE(u.\"username\", p.userid),\n        'userid', p.userid\n      )\n      FROM \"SIMAPO\".peminjaman p\n      LEFT JOIN public.user_list u ON u.\"NIP\" = p.userid\n      WHERE p.unitasetid = ua.id AND p.status = 'DIPINJAM'\n      ORDER BY p.createdat DESC LIMIT 1\n    ) AS peminjaman_aktif\n  FROM \"SIMAPO\".unit_aset ua\n  JOIN \"SIMAPO\".barang b ON b.id = ua.barangid\n  WHERE (\n    ua.qrcode = '{{ ($json.query.q).toString().replace(/'/g, \"''\") }}'\n    OR ua.qrcode LIKE '%qr=' || '{{ ($json.query.q).toString().replace(/'/g, \"''\") }}'\n    OR ua.id = REPLACE('{{ ($json.query.q).toString().replace(/'/g, \"''\") }}', 'SIMAPO-', '')\n    OR ua.barangid = REPLACE('{{ ($json.query.q).toString().replace(/'/g, \"''\") }}', 'SIMAPO-', '')\n  )\n  ORDER BY ua.nomorinventaris ASC\n) t;",
        "options": {}
      },
