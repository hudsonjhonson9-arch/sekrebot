  "name": "Session Login / Logout",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "path": "session-login",
        "responseMode": "lastNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        48,
        -256
      ],
      "id": "ffc1d625-e44c-482f-a1ff-d77c528bb67c",
      "name": "Webhook Session Login",
      "webhookId": "session-login-0001"
    },
    {
      "parameters": {
        "jsCode": "const q = $input.first().json.query || {};\nconst body = $input.first().json.body || {};\nconst nip = (q.nip || body.nip || '').replace(/'/g,\"''\");\nconst userId = (q.user_id || body.user_id || '').replace(/'/g,\"''\");\nconst role = (q.role || body.role || 'USER').replace(/'/g,\"''\");\nconst instansiId = (q.instansi_id || body.instansi_id || '').replace(/'/g,\"''\");\nconst action = (q.action || body.action || 'login').replace(/'/g,\"''\");\nconst sessionToken = (q.session_token || body.session_token || '').replace(/'/g,\"''\");\nif (action === 'login' && !nip) {\n  return [{ json: { ok: false, message: 'NIP required' } }];\n}\nreturn [{ json: { action, nip, user_id: userId, role, instansi_id: instansiId, session_token: sessionToken } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        -256
      ],
      "id": "afc1c2fe-affb-4c66-a7d2-48f547e034de",
      "name": "Parse"
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nif (d.action === 'login') {\n  return [{ json: { sql: `SELECT create_session('${d.nip}','${d.user_id}','${d.role}','${d.instansi_id}') AS session_token;` } }];\n} else {\n  return [{ json: { sql: `UPDATE auth_sessions SET is_active=false WHERE session_token='${d.session_token}';` } }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        -256
      ],
      "id": "b4e49161-9454-43b0-96aa-7fc72f239964",
      "name": "Build SQL"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "{{ $json.sql }}",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        656,
        -256
      ],
      "id": "0032b451-38ef-42f0-afcf-ae5ce4153322",
      "name": "Run SQL",
      "credentials": {
        "postgres": {
          "id": "vYOiyrTftLtD3zzd",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nif (d.session_token) {\n  return [{ json: { ok: true, session_token: d.session_token } }];\n}\nreturn [{ json: { ok: false, message: 'Session creation failed' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        -256
      ],
      "id": "e04fbe43-71b7-4659-b6e5-87204f448194",
      "name": "Format Response"
    }
  ],
