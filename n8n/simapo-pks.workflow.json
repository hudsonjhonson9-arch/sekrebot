          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(json_agg(row_to_json(t)), '[]'::json) as data FROM (SELECT s.id, s.kode, s.nama, s.kegiatan_id, k.kode as kegiatan_kode FROM \"SIMAPO\".subkegiatan s JOIN \"SIMAPO\".kegiatan k ON k.id = s.kegiatan_id WHERE ($json.query.kegiatan_id IS NULL OR s.kegiatan_id = $json.query.kegiatan_id::uuid) ORDER BY s.kode) t",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        400,
        100
