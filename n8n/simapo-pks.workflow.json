    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO \"SIMAPO\".program (kode, nama) VALUES ($json.body.kode, $json.body.nama) ON CONFLICT (kode) DO UPDATE SET nama = EXCLUDED.nama, updated_at = NOW() RETURNING id",
        "options": {}
