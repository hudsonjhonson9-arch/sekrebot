    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(json_agg(row_to_json(t)), '[]'::json) as data FROM (SELECT k.id, k.kode, k.nama, k.program_id, p.kode as program_kode FROM \"SIMAPO\".kegiatan k JOIN \"SIMAPO\".program p ON p.id = k.program_id WHERE ($json.query.program_id IS NULL OR k.program_id = $json.query.program_id::uuid) ORDER BY k.kode) t",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        400,
        0
      ],
      "id": "pks-008",
