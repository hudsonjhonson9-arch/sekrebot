# Salin ke .env lalu isi. .env sudah di .gitignore - jangan pernah di-commit.

# --- Wajib ---------------------------------------------------------------

# Connection string Postgres.
#   lokal:  postgresql://n8n:secret@localhost:5432/n8n_test
#   host:   postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Token bot Telegram (dari @BotFather). Tanpa ini /api/absen selalu membalas 401:
# verifikasi HMAC init_data tidak mungkin berhasil tanpa token bot.
TELEGRAM_BOT_TOKEN=

# Token meja absen, dipisah per instansi. Format: {"<instansi_id>": ["<token>"]}.
# Dikosongkan hanya kalau tidak ada sumber absen "meja".
MEJA_TOKENS={"bapperida":["ganti-dengan-token-acak"]}

# URL /exec Apps Script media (google-apps-script/Code.gs).
# Deploy wajib "Execute as: Me" dan akses "Anyone", kalau tidak yang balik
# halaman login Google (status 200 tapi body HTML, bukan JSON).
# Catatan: URL /exec bisa dipanggil siapa pun yang punya tautannya - jangan
# taruh di file yang di-commit.
GAS_WEBAPP_URL=https://script.google.com/macros/s/GANTI_DENGAN_DEPLOYMENT_ID/exec

# --- Opsional -----------------------------------------------------------

# 'require' kalau host Postgres butuh TLS. Lokal biasanya 'disable'.
PGSSL=disable

# Default 3000.
PORT=3000

# --- Notifikasi WhatsApp via WAHA (opsional) ----------------------------
# Tanpa WAHA_URL, broadcast keterangan hanya lewat Telegram (WhatsApp dilewati).
WAHA_URL=
WAHA_API_KEY=
WAHA_SESSION=default
# Grup WA tujuan broadcast (JID grup). Default = grup yang dipakai workflow n8n.
WAHA_KET_GROUP=6281239788212-1551250724@g.us

# --- Belum dipakai server/ (rencana migrasi media) ----------------------
# DRIVE_FOLDER_ID=
# N8N_TOKEN=
# FRONTEND_ORIGIN=